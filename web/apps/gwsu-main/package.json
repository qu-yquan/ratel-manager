{
  "private": true,
  "scripts": {
    "dev": "PORT=8000 UMI_DEV_SERVER_COMPRESS=none umi dev",
    "start": "umi dev",
    "build": "umi build",
    "postinstall": "umi setup",
    "prettier": "prettier --write '**/*.{js,jsx,tsx,ts,less,md,json}'",
    "test": "umi test",
    "test:coverage": "umi test --coverage"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,less,md,json}": [
      "prettier --write"
    ],
    "*.ts?(x)": [
      "prettier --parser=typescript --write"
    ]
  },
  "dependencies": {
    "@ag-ui/client": "^1.0.2",
    "@ag-ui/core": "^1.0.2",
    "@ant-design/icons": "^5.0.0",
    "@ant-design/pro-components": "^2.8.10",
    "@ant-design/pro-layout": "^7.0.0",
    "@copilotkit/react-core": "^1.77.1",
    "@copilotkit/react-ui": "^1.77.1",
    "@gwsu/core": "workspace:*",
    "@json-render/core": "^0.19.0",
    "@json-render/react": "^0.19.0",
    "antd": "^6.3.4",
    "echarts": "^6.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-draggable": "^4.5.0",
    "umi": "^4.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@umijs/plugins": "^4.0.0",
    "lint-staged": "^13.0.0",
    "prettier": "^2.8.0",
    "typescript": "^4.9.0"
  }
}
