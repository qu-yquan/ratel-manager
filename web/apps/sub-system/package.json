{
  "name": "sub-system",
  "private": true,
  "scripts": {
    "dev": "PORT=8001 umi dev",
    "start": "umi dev",
    "build": "umi build",
    "postinstall": "umi setup",
    "prettier": "prettier --write '**/*.{js,jsx,tsx,ts,less,md,json}'",
    "test": "umi test",
    "test:coverage": "umi test --coverage"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,less,md,json}": [
      "prettier --write"
    ],
    "*.ts?(x)": [
      "prettier --parser=typescript --write"
    ]
  },
  "dependencies": {
    "@ant-design/icons": "^5.0.0",
    "@antv/g6": "^5.1.0",
    "@gwsu/core": "workspace:*",
    "antd": "^6.3.4",
    "crypto-js": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "umi": "^4.0.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@umijs/plugins": "^4.0.0",
    "lint-staged": "^13.0.0",
    "prettier": "^2.8.0",
    "typescript": "^4.9.0"
  }
}
